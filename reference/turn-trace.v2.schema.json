{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://callsmith.dev/schemas/turn-trace.v2.json",
  "title": "Callsmith Turn Trace (v2)",
  "description": "Profile-aware trace. The required per-turn timestamp set depends on environment.instrumentation_profile: cascaded_full requires the ten cascaded legs; s2s_transport requires only the boundaries an opaque speech-to-speech provider plus transport expose (speech_end, provider_first_output, audio_first_playout, audio_first_audible); end_to_end requires only speech_end and audio_first_audible. Boundaries the provider does not expose must not be synthesized. The runtime validator (evals/csb/latency/validate.mjs) remains the authority; these if/then conditionals mirror it for static tooling.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "track", "run_id", "environment", "clock", "turns"],
  "properties": {
    "schema_version": { "const": 2 },
    "track": { "enum": ["controlled", "live"] },
    "run_id": { "type": "string", "minLength": 1 },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "instrumentation_profile", "surface", "transport", "region", "runtime", "providers", "network_profile", "audio_format"],
      "properties": {
        "architecture": { "enum": ["realtime_s2s", "cascaded", "hybrid"] },
        "instrumentation_profile": { "enum": ["cascaded_full", "s2s_transport", "end_to_end"] },
        "surface": { "enum": ["inbound_pstn", "outbound_pstn", "web_voice", "webrtc_app", "whatsapp_voice"] },
        "transport": { "type": "string", "minLength": 1 },
        "region": { "type": "string", "minLength": 1 },
        "runtime": { "type": "string", "minLength": 1 },
        "providers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "network_profile": { "type": "string", "minLength": 1 },
        "audio_format": { "type": "string", "minLength": 1 },
        "commit_sha": { "type": "string", "minLength": 1 }
      }
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "unit", "origin_id"],
      "properties": {
        "type": { "const": "monotonic" },
        "unit": { "const": "ms" },
        "origin_id": { "type": "string", "minLength": 1 },
        "synchronization_error_ms": { "type": "number", "minimum": 0 }
      }
    },
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/turn" }
    }
  },
  "$defs": {
    "timestamp": { "type": "number", "minimum": 0 },
    "turn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turn_id", "speech_end_ms", "speech_end_source", "quality"],
      "properties": {
        "turn_id": { "type": "string", "minLength": 1 },
        "speech_end_ms": { "$ref": "#/$defs/timestamp" },
        "speech_end_source": { "enum": ["labeled", "detector"] },
        "eou_detected_ms": { "$ref": "#/$defs/timestamp" },
        "transcript_final_ms": { "$ref": "#/$defs/timestamp" },
        "llm_request_ms": { "$ref": "#/$defs/timestamp" },
        "llm_first_token_ms": { "$ref": "#/$defs/timestamp" },
        "text_committed_ms": { "$ref": "#/$defs/timestamp" },
        "tts_request_ms": { "$ref": "#/$defs/timestamp" },
        "tts_first_chunk_ms": { "$ref": "#/$defs/timestamp" },
        "provider_first_output_ms": { "$ref": "#/$defs/timestamp", "description": "First response received from the provider (e.g. Gemini first modelTurn). Distinct from audio_first_playout_ms (submitted to playout) and audio_first_audible_ms (heard at the boundary). Equal values are valid only when one real callback represents both." },
        "audio_first_playout_ms": { "$ref": "#/$defs/timestamp", "description": "First response submitted to the local/transport playout path. For PSTN, Twilio `mark` is playback-completed, NOT onset — a caller-boundary loopback is required to populate this as onset." },
        "audio_first_audible_ms": { "$ref": "#/$defs/timestamp" },
        "playback_completed_ms": { "$ref": "#/$defs/timestamp", "description": "PSTN playback completion (Twilio `mark` echo). Playback-completed, not onset. Do not infer playout onset by subtracting chunk duration." },
        "barge_in_detected_ms": { "$ref": "#/$defs/timestamp" },
        "cancellation_sent_ms": { "$ref": "#/$defs/timestamp" },
        "cancellation_ack_ms": { "$ref": "#/$defs/timestamp" },
        "path": { "enum": ["realtime_s2s", "cascaded"], "description": "Optional per-turn path for hybrid traces. Validation is per-turn against this path's profile chain when present." },
        "quality": {
          "type": "object",
          "additionalProperties": false,
          "required": ["premature_cutoff", "false_interruption", "response_correct", "audio_underruns"],
          "properties": {
            "premature_cutoff": { "type": "boolean" },
            "false_interruption": { "type": "boolean" },
            "response_correct": { "type": "boolean" },
            "audio_underruns": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "environment": { "properties": { "instrumentation_profile": { "const": "cascaded_full" } } } } },
      "then": {
        "properties": {
          "turns": {
            "items": {
              "required": ["speech_end_ms", "speech_end_source", "eou_detected_ms", "transcript_final_ms", "llm_request_ms", "llm_first_token_ms", "text_committed_ms", "tts_request_ms", "tts_first_chunk_ms", "audio_first_playout_ms", "audio_first_audible_ms", "quality"]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "environment": { "properties": { "instrumentation_profile": { "const": "s2s_transport" } } } } },
      "then": {
        "properties": {
          "turns": {
            "items": {
              "required": ["speech_end_ms", "speech_end_source", "provider_first_output_ms", "audio_first_playout_ms", "audio_first_audible_ms", "quality"]
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "environment": { "properties": { "instrumentation_profile": { "const": "end_to_end" } } } } },
      "then": {
        "properties": {
          "turns": {
            "items": {
              "required": ["speech_end_ms", "speech_end_source", "audio_first_audible_ms", "quality"]
            }
          }
        }
      }
    }
  ]
}
