{
  "id": "acme-telephony",
  "kind": "telephony",
  "label": "Acme Telephony (Registry)",
  "transport": "websocket",
  "ingest": { "format": "mulaw", "sample_rate": 8000, "channels": 1, "bit_depth": 8 },
  "egress": { "format": "mulaw", "sample_rate": 8000, "channels": 1, "bit_depth": 8 },
  "directions": ["inbound", "outbound"],
  "native_capabilities": [],
  "lifecycle": ["call_started", "media_active", "call_ended"],
  "potholes": [
    { "id": "frame-size", "severity": "warning", "note": "Acme sends media in 20ms frames." }
  ],
  "env_keys": ["ACME_API_KEY", "ACME_APP_ID"],
  "doc_urls": ["https://docs.example-acme.com/media-stream"]
}
